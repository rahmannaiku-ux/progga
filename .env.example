# --- Database (Supabase) ---
# Pooled connection (runtime queries) — from Supabase dashboard:
# Project Settings > Database > Connection string > Transaction pooler
# (port 6543, pgbouncer). This is what the app uses at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Unpooled connection (schema changes only) — same dashboard page,
# "Session pooler" or direct connection (port 5432). Required because
# the pooled connection above doesn't support the prepared statements
# `prisma db push` / `prisma migrate` issue.
# NOTE: Supabase's plain direct-connection host (db.<ref>.supabase.co)
# is IPv6-only on the Free plan. If you get P1001 connection refused,
# use the IPv4-reachable Session pooler host instead:
# aws-0-<region>.pooler.supabase.com:5432
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth (legacy Clerk — PHASE 5: no runtime code depends on these
# anymore; @clerk/nextjs and svix were removed from package.json. Kept
# documented, not deleted, only because CLERK_WEBHOOK_SECRET/the keys
# below may still be referenced in your hosting provider's env config
# until you clean that up there too — safe to remove from both once
# you've confirmed nothing points at a Clerk dashboard anymore.) ---
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SECRET=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- File uploads (PDFs, resources, avatars) ---
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# --- Google Drive storage (student/user uploads: avatars, assignment
# submissions, certificates, community images, other files) ---
# Course content (YouTube videos, lesson Slides/resources) is unrelated
# and does NOT use these — see lib/storage/index.ts.
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud
# Console for the ONE dedicated Google account that will hold all
# uploads, then add its redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/storage/google/callback
# 32-byte key (base64) used to encrypt the Drive refresh token at rest.
# Generate with: openssl rand -base64 32
# Never reuse this for anything else, and never commit it.
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=

# --- Google Docs question import (mentor-dashboard question bank) ---
# Reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above (same OAuth
# client), but is a SEPARATE flow from Drive storage — every teacher
# connects their OWN Google account, on-demand, per import session
# (no refresh token, nothing persisted to the database). Needs its own
# redirect URI registered in Google Cloud Console, distinct from
# GOOGLE_REDIRECT_URI above, and the Google Docs API enabled.
GOOGLE_DOCS_REDIRECT_URI=http://localhost:3000/api/mentor/google-docs/callback

# --- OCR for scanned/image-only PDF question import (not implemented) ---
# Setting this does NOT enable OCR by itself — see lib/question-import/ocr.ts.
# Left unset intentionally; documented here so the toggle point is easy to find.
OCR_PROVIDER=

# --- Gemini AI question generation (mentor question bank, "AI Generate" tab) ---
# Server-side only — never exposed to the browser, never prefixed
# NEXT_PUBLIC_. Get a key from https://aistudio.google.com/apikey.
# Leaving this unset disables the AI Generate tab and Question Bank
# "AI" transform buttons with a clear "not configured" message; nothing
# else in the app depends on it.
GEMINI_API_KEY=
# Optional — defaults to gemini-1.5-flash if unset.
GEMINI_MODEL=

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM="Proggaa <no-reply@yourdomain.com>"

# --- Rate limiting / caching (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Cron (Vercel Cron or similar, protects /api/cron/*) ---
CRON_SECRET=

# --- Payments (manual bKash + future Payment Bridge) ---
# Telegram is an ADMIN NOTIFICATION layer only — never required for
# verification to work. Leave both blank to disable it entirely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Telegram bot integration (the standalone Proggaa Telegram bot) ---
# Distinct from TELEGRAM_BOT_TOKEN/TELEGRAM_ADMIN_CHAT_ID above, which
# is only a one-way admin alert channel. This section is the actual
# bidirectional integration with the separate bot repo.
#
# Server-to-server secret the bot presents as `X-Api-Key` on every
# /api/telegram/link and /api/bot/* request. Never prefixed
# NEXT_PUBLIC_ — never sent to the browser. Generate with:
#   openssl rand -hex 32
PROGGAA_API_KEY=
#
# The bot's public HTTPS webhook URL that this website posts to for
# outbound events (payment approved/rejected, results published, etc).
# Leave unset to disable outbound push entirely (sendBotEvent() becomes
# a no-op) — nothing else in the integration depends on it.
PROGGAA_BOT_WEBHOOK_URL=
#
# Separate shared secret (NOT PROGGAA_API_KEY) used to HMAC-sign the
# body of every outbound event to PROGGAA_BOT_WEBHOOK_URL, so the two
# directions of trust can rotate independently. Generate with:
#   openssl rand -hex 32
PROGGAA_BOT_WEBHOOK_SECRET=

# Optional. Server clock for logs (Docker sets this already). User-visible dates are pinned to Bangladesh time in src/lib/timezone.ts regardless.
# TZ=Asia/Dhaka

# Anti-DevTools deterrent (see README "DevTools protection").
# Default: ON in production, OFF in `next dev` (so your own DevTools work).
# ANTI_DEVTOOLS=on|off
# Comma list of roles it applies to (default STUDENT — teachers/admins are exempt).
# ANTI_DEVTOOLS_ROLES=STUDENT

# --- Live Room (Stream Chat) -----------------------------------------
# Only needed once the `live_room` feature flag is turned on. See
# scripts/stream-acceptance.ts for the acceptance tests to run against a
# TEST Stream app before enabling this for real students.
#
# Public app key -- safe to ship to the browser (paired with STREAM_API_SECRET,
# not a secret itself).
NEXT_PUBLIC_STREAM_API_KEY=
# Same value, server-side (kept in sync with the NEXT_PUBLIC_ one above so
# server code doesn't have to read a NEXT_PUBLIC_ var).
STREAM_API_KEY=
# SERVER-ONLY. Never prefixed NEXT_PUBLIC_, never sent to the browser, never
# logged. Generated in the Stream dashboard for the app above.
STREAM_API_SECRET=
# Optional. Per-channel connection cap once the room is LIVE -- students
# beyond this still get video but see "chat is full". Default: 90.
# LIVE_CHAT_MAX_CONNECTIONS=90
#
# --- Live Room Stream acceptance tests (scripts/stream-acceptance.ts only) ---
# A SEPARATE test Stream app/credentials -- never point these at production.
# STREAM_TEST_API_KEY=
# STREAM_TEST_API_SECRET=

# --- Proggaa custom auth: OTP + password (Phase 2) --------------------
# SERVER-ONLY secret used to HMAC-sign OTP codes before they're stored
# (src/lib/auth/otp.ts). Never sent to the browser, never logged.
# Generate with: openssl rand -hex 32
OTP_HMAC_SECRET=
# Optional, non-production only: set to 1 to log generated OTP codes to
# the server console for local development. Has no effect when
# NODE_ENV=production, regardless of this value.
# OTP_DEV_LOG=1
# Optional, non-production only: set to 1 to bypass the 3-requests/12h
# quota below for local testing. Does NOT touch the short-term rate
# limiter or the 60s resend cooldown — you'll still wait 60s between
# resends. Has no effect when NODE_ENV=production, regardless of this
# value — never enable in a deployed environment.
# OTP_DEV_BYPASS_QUOTA=1

# --- Onecodesoft SMS provider (https://onecodesoft.com/) --------------
# PHASE 5: now a real implementation (src/lib/sms/onecodesoft.ts),
# verified against the vendor's own WordPress plugin source
# (bulk-sms-by-onecodesoft.zip -> includes/class-bulk-sms-api.php).
# Get your API key from https://onecodesoft.com/user-panel/bulk-sms
# (per that plugin's README) and set it below. Required in production —
# without it, requestRegistrationOtp/requestPasswordResetOtp will still
# succeed at the OTP-record level but the actual SMS send will throw,
# same as the old stub did.
ONECODESOFT_API_KEY=
# REQUIRED — a registered Onecodesoft Sender ID. The plugin's own README
# FAQ claims this is optional ("Is the Sender ID mandatory? No..."), but
# that's stale: its admin settings form marks the field required, its
# own save/send handlers reject an empty value ("Sender ID is
# required."), and the live Onecodesoft API rejects an empty senderid
# the same way (confirmed by an actual failed send). Register one at
# https://onecodesoft.com/user-panel/bulk-sms and set it here — SMS
# sending (and therefore registration/password-reset OTP) fails
# without it.
ONECODESOFT_SENDER_ID=
# Optional override of the API base URL (defaults to
# https://sms.onecodesoft.com/api, the exact value hardcoded in the
# plugin's Bulk_Sms_Api class) — only set this if Onecodesoft gives you
# an account-specific or sandbox base URL; nothing in the supplied
# plugin documents one.
# ONECODESOFT_API_URL=
